{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ add }}" class="btn btn-primary"><i class="fa fa-plus"></i></a>
        <a href="{{ back }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if warning %}
      <div class="alert alert-danger alert-dismissible" role="alert">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <i class="fa fa-exclamation-circle"></i> {{ warning }}
      </div>
    {% endif %}
    {% if success %}
      <div class="alert alert-success alert-dismissible" role="alert">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <i class="fa fa-check-circle"></i> {{ success }}
      </div>
    {% endif %}

    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-filter"></i> {{ text_filter }}</h3></div>
      <div class="panel-body">
        <form method="get" class="form-inline">
          <input type="hidden" name="route" value="extension/payment/subscription_plan_template" />
          <input type="hidden" name="user_token" value="{{ user_token }}" />
          <input type="text" name="filter_name" value="{{ filter_name }}" class="form-control" placeholder="{{ text_name }}" />
          <select name="filter_status" class="form-control">
            <option value="">{{ text_all_statuses }}</option>
            <option value="active" {{ filter_status == 'active' ? 'selected="selected"' : '' }}>{{ text_active }}</option>
            <option value="archived" {{ filter_status == 'archived' ? 'selected="selected"' : '' }}>{{ text_archived }}</option>
          </select>
          <button type="submit" class="btn btn-default"><i class="fa fa-search"></i> {{ button_filter }}</button>
        </form>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-body">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <td>{{ column_code }}</td>
              <td>{{ column_name }}</td>
              <td>{{ column_category }}</td>
              <td>{{ column_status }}</td>
              <td class="text-right">{{ column_action }}</td>
            </tr>
          </thead>
          <tbody>
            {% for template in templates %}
              <tr>
                <td>{{ template.code }}</td>
                <td>{{ template.name }}</td>
                <td>{{ template.category_indicator }}</td>
                <td>{{ template.status == 'active' ? text_active : text_archived }}</td>
                <td class="text-right">
                  <a href="{{ template.edit }}" class="btn btn-primary" data-toggle="tooltip" title="{{ button_edit }}"><i class="fa fa-pencil"></i></a>
                  {% if template.status == 'active' and can_modify %}
                    <a href="{{ template.archive }}" class="btn btn-warning" data-toggle="tooltip" title="{{ button_archive }}" onclick="return confirm('{{ text_confirm_archive }}');"><i class="fa fa-archive"></i></a>
                  {% endif %}
                </td>
              </tr>
            {% else %}
              <tr>
                <td class="text-center" colspan="5">{{ text_no_results }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        <div class="row">
          <div class="col-sm-12 text-right">{{ pagination }}</div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}

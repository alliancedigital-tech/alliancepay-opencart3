{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ back }}" data-toggle="tooltip" title="{{ button_back }}" class="btn btn-default">
          <i class="fa fa-reply"></i>
        </a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-filter"></i> {{ text_filter }}</h3></div>
      <div class="panel-body">
        <form method="get" class="form-inline">
          <input type="hidden" name="route" value="extension/payment/subscription" />
          <input type="hidden" name="user_token" value="{{ user_token }}" />
          <input type="text" name="filter_customer" value="{{ filter_customer }}" placeholder="{{ text_customer }}" class="form-control" />
          <input type="text" name="filter_provider_order_id" value="{{ filter_provider_order_id }}" placeholder="{{ text_provider_order_id }}" class="form-control" />
          <select name="filter_status" class="form-control">
            <option value="">{{ text_all_statuses }}</option>
            {% for status in ['PENDING', 'ACTIVE', 'CANCELED', 'ERROR'] %}
              <option value="{{ status }}" {{ filter_status == status ? 'selected="selected"' : '' }}>{{ status }}</option>
            {% endfor %}
          </select>
          <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> {{ button_filter }}</button>
        </form>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-body table-responsive">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <td>{{ column_order_id }}</td>
              <td>{{ column_customer }}</td>
              <td>{{ column_plan }}</td>
              <td>{{ column_product }}</td>
              <td>{{ column_status }}</td>
              <td>{{ column_provider_order_id }}</td>
              <td>{{ column_created_at }}</td>
              <td class="text-right">{{ column_action }}</td>
            </tr>
          </thead>
          <tbody>
            {% for subscription in subscriptions %}
              <tr>
                <td>{{ subscription.order_id }}</td>
                <td>{{ subscription.customer_name }}<br /><small>{{ subscription.customer_email }}</small></td>
                <td>{{ subscription.plan_name }}</td>
                <td>{{ subscription.product_name }}</td>
                <td>
                  <span class="label {{ subscription.status == 'ACTIVE' ? 'label-success' : (subscription.status == 'ERROR' ? 'label-danger' : 'label-default') }}">
                    {{ subscription.status }}
                  </span>
                </td>
                <td>{{ subscription.provider_order_id }}</td>
                <td>{{ subscription.created_at }}</td>
                <td class="text-right">
                  <a href="{{ subscription.diagnostics }}" class="btn btn-info btn-sm" data-toggle="tooltip" title="{{ button_diagnostics }}">
                    <i class="fa fa-stethoscope"></i>
                  </a>
                </td>
              </tr>
            {% else %}
              <tr>
                <td class="text-center" colspan="8">{{ text_no_results }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        {% if pagination|length > 1 %}
          <ul class="pagination">
            {% for p in pagination %}
              <li class="{{ p.active ? 'active' : '' }}"><a href="{{ p.href }}">{{ p.page }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{{ footer }}

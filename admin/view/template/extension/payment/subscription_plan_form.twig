{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        {% if not read_only %}
          <button type="submit" form="form-plan" class="btn btn-primary"><i class="fa fa-save"></i></button>
        {% endif %}
        <a href="{{ back }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if warning %}
      <div class="alert alert-danger alert-dismissible" role="alert">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <i class="fa fa-exclamation-circle"></i> {{ warning }}
      </div>
    {% endif %}
    {% if success %}
      <div class="alert alert-success alert-dismissible" role="alert">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <i class="fa fa-check-circle"></i> {{ success }}
      </div>
    {% endif %}

    {% if read_only and plan.status == 'ERROR' %}
      <div class="alert alert-danger"><i class="fa fa-exclamation-triangle"></i> {{ text_sync_error_notice }} {{ plan.sync_error }}</div>
    {% endif %}

    <div class="panel panel-default">
      <div class="panel-body">
        {% if read_only %}
          <div class="row">
            <div class="col-sm-6">
              <div class="form-group"><label class="control-label">{{ entry_product }}</label><p class="form-control-static">{{ plan.product_name }}</p></div>
              <div class="form-group"><label class="control-label">{{ column_provider_plan_id }}</label><p class="form-control-static">{{ plan.provider_plan_id }}</p></div>
              <div class="form-group"><label class="control-label">{{ text_version_id }}</label><p class="form-control-static">{{ plan.version_id }}</p></div>
              <div class="form-group"><label class="control-label">{{ column_status }}</label><p class="form-control-static">{{ plan.status }}</p></div>
            </div>
            <div class="col-sm-6">
              <div class="form-group"><label class="control-label">{{ entry_category }}</label><p class="form-control-static">{{ plan.category_indicator }}</p></div>
              <div class="form-group"><label class="control-label">{{ column_sync_status }}</label><p class="form-control-static">{{ plan.sync_status }}</p></div>
              <div class="form-group"><label class="control-label">{{ column_new_customers }}</label><p class="form-control-static">{{ plan.is_active ? text_yes : text_no }}</p></div>
              <div class="form-group"><label class="control-label">{{ column_active_subscriptions }}</label><p class="form-control-static">{{ plan.active_subscriptions_count }}</p></div>
            </div>
          </div>

          <hr />
          <h4>{{ text_rules }}</h4>
          <table class="table table-bordered">
            <thead><tr><td>{{ entry_payment_from }}</td><td>{{ entry_payment_to }}</td><td>{{ entry_interval_value }}</td><td>{{ text_interval_unit }}</td><td>{{ text_amount }}</td></tr></thead>
            <tbody>
              {% for rule in rules %}
                <tr>
                  <td>{{ rule.paymentNumberFrom }}</td>
                  <td>{{ rule.paymentNumberTo }}</td>
                  <td>{{ rule.intervalValue }}</td>
                  <td>{{ rule.intervalUnit }}</td>
                  <td>{{ rule.coinAmount }} ({{ rule.currency }})</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>

          <hr />
          <div class="btn-toolbar">
            {% if plan.is_active %}
              <a href="{{ deactivate_url }}" class="btn btn-warning" onclick="return confirm('{{ text_confirm_deactivate }}');"><i class="fa fa-pause"></i> {{ button_deactivate }}</a>
            {% else %}
              <a href="{{ reactivate_url }}" class="btn btn-default"><i class="fa fa-play"></i> {{ button_reactivate }}</a>
            {% endif %}
            <a href="{{ reprice_url }}" class="btn btn-info"><i class="fa fa-money"></i> {{ button_reprice }}</a>
            {% if is_archive_candidate %}
              <button type="button" id="btn-archive" class="btn btn-danger"><i class="fa fa-archive"></i> {{ button_archive }}</button>
            {% endif %}
          </div>

          <form id="form-archive" action="{{ archive_url }}" method="post" style="display:none;">
            <input type="hidden" name="plan_id" value="{{ plan.plan_id }}" />
            <input type="hidden" name="confirm_archive" value="1" />
          </form>
          <script>
            var archiveBtn = document.getElementById('btn-archive');
            if (archiveBtn) {
              archiveBtn.addEventListener('click', function () {
                if (confirm('{{ text_confirm_archive }}')) {
                  document.getElementById('form-archive').submit();
                }
              });
            }
          </script>
        {% else %}
          <form id="form-plan" class="form-horizontal" action="{{ action }}" method="post">
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_product }}</label>
              <div class="col-sm-10">
                <input type="text" id="input-product-name" value="{{ plan.product_name }}" class="form-control" autocomplete="off" placeholder="{{ text_product_search_placeholder }}" />
                <input type="hidden" name="product_id" id="input-product-id" value="{{ plan.product_id }}" />
                <ul id="product-autocomplete-results" class="dropdown-menu" style="display:none; max-height:200px; overflow-y:auto;"></ul>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_template }}</label>
              <div class="col-sm-10">
                <select name="template_id" id="input-template" class="form-control">
                  <option value="">{{ text_no_template }}</option>
                  {% for template in templates %}
                    <option value="{{ template.template_id }}" data-rules="{{ template.rules_template }}">{{ template.name }}</option>
                  {% endfor %}
                </select>
                <p class="help-block">{{ help_template }}</p>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_name }}</label>
              <div class="col-sm-10"><input type="text" name="name" value="{{ plan.name }}" class="form-control" /></div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_description }}</label>
              <div class="col-sm-10">
                <textarea name="description" rows="2" class="form-control">{{ plan.description }}</textarea>
                <p class="help-block">{{ help_description }}</p>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_category }}</label>
              <div class="col-sm-10"><input type="text" name="category_indicator" value="{{ plan.category_indicator }}" class="form-control" /></div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_applies_from }}</label>
              <div class="col-sm-5"><input type="datetime-local" name="applies_from" value="{{ plan.applies_from }}" class="form-control" /></div>
              <label class="col-sm-1 control-label">{{ entry_applies_to }}</label>
              <div class="col-sm-4"><input type="datetime-local" name="applies_to" value="{{ plan.applies_to }}" class="form-control" /></div>
            </div>

            <hr />
            <h4>{{ text_rules }}</h4>
            <p class="help-block">{{ help_rules }}</p>

            <div id="rules-container">
              {% for rule in rules %}
                <div class="row rule-row" style="margin-bottom:10px;">
                  <div class="col-sm-2"><input type="number" name="rule_payment_number_from[]" value="{{ rule.paymentNumberFrom }}" class="form-control" placeholder="{{ entry_payment_from }}" /></div>
                  <div class="col-sm-2"><input type="number" name="rule_payment_number_to[]" value="{{ rule.paymentNumberTo }}" class="form-control" placeholder="{{ entry_payment_to }}" /></div>
                  <div class="col-sm-2"><input type="number" name="rule_interval_value[]" value="{{ rule.intervalValue }}" class="form-control" placeholder="{{ entry_interval_value }}" /></div>
                  <div class="col-sm-2">
                    <select name="rule_interval_unit[]" class="form-control">
                      {% for unit in ['DAY', 'WEEK', 'MONTH'] %}
                        <option value="{{ unit }}" {{ rule.intervalUnit == unit ? 'selected="selected"' : '' }}>{{ unit }}</option>
                      {% endfor %}
                    </select>
                  </div>
                  <div class="col-sm-2"><input type="number" name="rule_coin_amount[]" value="{{ rule.coinAmount }}" class="form-control" placeholder="{{ text_amount }}" /></div>
                  <div class="col-sm-1">
                    <select name="rule_currency[]" class="form-control">
                      {% for currency in currencies %}
                        <option value="{{ currency }}">{{ currency }}</option>
                      {% endfor %}
                    </select>
                  </div>
                  <div class="col-sm-1"><button type="button" class="btn btn-danger remove-rule"><i class="fa fa-minus"></i></button></div>
                </div>
              {% endfor %}
            </div>
            <button type="button" id="add-rule" class="btn btn-default"><i class="fa fa-plus"></i> {{ button_add_rule }}</button>
          </form>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% if not read_only %}
<div id="rule-row-template" style="display:none;">
  <div class="row rule-row" style="margin-bottom:10px;">
    <div class="col-sm-2"><input type="number" name="rule_payment_number_from[]" class="form-control" placeholder="{{ entry_payment_from }}" /></div>
    <div class="col-sm-2"><input type="number" name="rule_payment_number_to[]" class="form-control" placeholder="{{ entry_payment_to }}" /></div>
    <div class="col-sm-2"><input type="number" name="rule_interval_value[]" value="1" class="form-control" placeholder="{{ entry_interval_value }}" /></div>
    <div class="col-sm-2">
      <select name="rule_interval_unit[]" class="form-control">
        <option value="DAY">DAY</option><option value="WEEK">WEEK</option><option value="MONTH" selected="selected">MONTH</option>
      </select>
    </div>
    <div class="col-sm-2"><input type="number" name="rule_coin_amount[]" value="0" class="form-control" placeholder="{{ text_amount }}" /></div>
    <div class="col-sm-1">
      <select name="rule_currency[]" class="form-control">
        {% for currency in currencies %}<option value="{{ currency }}">{{ currency }}</option>{% endfor %}
      </select>
    </div>
    <div class="col-sm-1"><button type="button" class="btn btn-danger remove-rule"><i class="fa fa-minus"></i></button></div>
  </div>
</div>

<script>
  (function () {
    var container = document.getElementById('rules-container');
    var rowTemplate = document.getElementById('rule-row-template').innerHTML;

    document.getElementById('add-rule').addEventListener('click', function () {
      var wrapper = document.createElement('div');
      wrapper.innerHTML = rowTemplate;
      var newRow = wrapper.firstElementChild;
      container.appendChild(newRow);
      applyPriceToRow(newRow, true);
    });

    container.addEventListener('click', function (e) {
      if (e.target.closest('.remove-rule')) {
        e.target.closest('.rule-row').remove();
      }
    });

    var nameInput = document.getElementById('input-product-name');
    var idInput = document.getElementById('input-product-id');
    var results = document.getElementById('product-autocomplete-results');
    var autocompleteUrl = '{{ product_autocomplete_url|raw }}';
    var timer = null;
    var selectedProductPrice = null;

    function isTrialRow(row) {
      var from = row.querySelector('[name="rule_payment_number_from[]"]');
      var to = row.querySelector('[name="rule_payment_number_to[]"]');
      return !!from && !!to && from.value === '1' && to.value === '1';
    }

    function applyPriceToRow(row, force) {
      if (selectedProductPrice === null || isTrialRow(row)) { return; }
      var amountInput = row.querySelector('[name="rule_coin_amount[]"]');
      if (!amountInput) { return; }
      if (force || !amountInput.value || parseFloat(amountInput.value) === 0) {
        amountInput.value = selectedProductPrice;
      }
    }

    nameInput.addEventListener('input', function () {
      idInput.value = '';
      clearTimeout(timer);
      var term = nameInput.value;
      if (term.length < 3) { results.style.display = 'none'; return; }
      timer = setTimeout(function () {
        fetch(autocompleteUrl + '&filter_name=' + encodeURIComponent(term))
          .then(function (r) { return r.json(); })
          .then(function (items) {
            results.innerHTML = '';
            items.forEach(function (item) {
              var li = document.createElement('li');
              var a = document.createElement('a');
              a.href = '#';
              a.textContent = item.name + ' (' + item.model + ')';
              a.addEventListener('click', function (e) {
                e.preventDefault();
                nameInput.value = item.name;
                idInput.value = item.product_id;
                results.style.display = 'none';
                selectedProductPrice = Math.round(parseFloat(item.price) * 100) || null;
                container.querySelectorAll('.rule-row').forEach(function (row) {
                  applyPriceToRow(row, false);
                });
              });
              li.appendChild(a);
              results.appendChild(li);
            });
            results.style.display = items.length ? 'block' : 'none';
          });
      }, 300);
    });

    var templateSelect = document.getElementById('input-template');
    templateSelect.addEventListener('change', function () {
      var option = templateSelect.options[templateSelect.selectedIndex];
      var rulesJson = option.getAttribute('data-rules');
      if (!rulesJson) { return; }
      try {
        var rules = JSON.parse(rulesJson);
      } catch (e) { return; }
      container.innerHTML = '';
      rules.forEach(function (rule) {
        var wrapper = document.createElement('div');
        wrapper.innerHTML = rowTemplate;
        var row = wrapper.firstElementChild;
        row.querySelector('[name="rule_payment_number_from[]"]').value = rule.paymentNumberFrom || '';
        row.querySelector('[name="rule_payment_number_to[]"]').value = rule.paymentNumberTo || '';
        row.querySelector('[name="rule_interval_value[]"]').value = rule.intervalValue || 1;
        row.querySelector('[name="rule_interval_unit[]"]').value = rule.intervalUnit || 'MONTH';
        container.appendChild(row);
        applyPriceToRow(row, true);
      });
    });
  })();
</script>
{% endif %}
{{ footer }}

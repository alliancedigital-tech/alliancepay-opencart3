{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        {% if not permission_denied %}
          <button type="submit" form="form-reprice" class="btn btn-primary" onclick="return confirm('{{ text_confirm_submit }}');"><i class="fa fa-save"></i></button>
        {% endif %}
        <a href="{{ back }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if permission_denied %}
      <div class="alert alert-danger"><i class="fa fa-lock"></i> {{ text_permission_denied }}</div>
    {% else %}
      {% if warning %}
        <div class="alert alert-danger alert-dismissible" role="alert">
          <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
          <i class="fa fa-exclamation-circle"></i> {{ warning }}
        </div>
      {% endif %}
      {% if success %}
        <div class="alert alert-success alert-dismissible" role="alert">
          <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
          <i class="fa fa-check-circle"></i> {{ success }}
        </div>
      {% endif %}

      <div class="alert alert-warning">
        <i class="fa fa-exclamation-triangle"></i>
        <strong>{{ text_affected_count_label }}: {{ active_subscription_count }}</strong><br />
        {{ text_lead_time_notice|format(min_lead_days) }}
      </div>

      <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-money"></i> {{ text_current_rules }}</h3></div>
        <div class="panel-body">
          <table class="table table-bordered">
            <thead><tr><td>{{ entry_payment_from }}</td><td>{{ entry_payment_to }}</td><td>{{ entry_interval_value }}</td><td>{{ text_interval_unit }}</td><td>{{ text_amount }}</td></tr></thead>
            <tbody>
              {% for rule in rules %}
                <tr>
                  <td>{{ rule.paymentNumberFrom }}</td>
                  <td>{{ rule.paymentNumberTo }}</td>
                  <td>{{ rule.intervalValue }}</td>
                  <td>{{ rule.intervalUnit }}</td>
                  <td>{{ rule.coinAmount }} ({{ rule.currency }})</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>

      <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_new_rules }}</h3></div>
        <div class="panel-body">
          <form id="form-reprice" class="form-horizontal" action="{{ action }}" method="post">
            <input type="hidden" name="plan_id" value="{{ plan.plan_id }}" />

            <div id="rules-container">
              {% for rule in rules %}
                <div class="row rule-row" style="margin-bottom:10px;">
                  <div class="col-sm-2"><input type="number" name="rule_payment_number_from[]" value="{{ rule.paymentNumberFrom }}" class="form-control" placeholder="{{ entry_payment_from }}" /></div>
                  <div class="col-sm-2"><input type="number" name="rule_payment_number_to[]" value="{{ rule.paymentNumberTo }}" class="form-control" placeholder="{{ entry_payment_to }}" /></div>
                  <div class="col-sm-2"><input type="number" name="rule_interval_value[]" value="{{ rule.intervalValue }}" class="form-control" placeholder="{{ entry_interval_value }}" /></div>
                  <div class="col-sm-2">
                    <select name="rule_interval_unit[]" class="form-control">
                      {% for unit in ['DAY', 'WEEK', 'MONTH'] %}
                        <option value="{{ unit }}" {{ rule.intervalUnit == unit ? 'selected="selected"' : '' }}>{{ unit }}</option>
                      {% endfor %}
                    </select>
                  </div>
                  <div class="col-sm-2"><input type="number" name="rule_coin_amount[]" value="{{ rule.coinAmount }}" class="form-control" placeholder="{{ text_amount }}" /></div>
                  <div class="col-sm-1">
                    <select name="rule_currency[]" class="form-control">
                      {% for currency in currencies %}<option value="{{ currency }}" {{ rule.currency == currency ? 'selected="selected"' : '' }}>{{ currency }}</option>{% endfor %}
                    </select>
                  </div>
                  <div class="col-sm-1"><button type="button" class="btn btn-danger remove-rule"><i class="fa fa-minus"></i></button></div>
                </div>
              {% endfor %}
            </div>
            <button type="button" id="add-rule" class="btn btn-default"><i class="fa fa-plus"></i> {{ button_add_rule }}</button>

            <hr />

            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_applies_from }}</label>
              <div class="col-sm-10">
                <input type="datetime-local" name="applies_from" class="form-control" />
                <p class="help-block">{{ text_lead_time_notice|format(min_lead_days) }}</p>
              </div>
            </div>

            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_reason }}</label>
              <div class="col-sm-10"><textarea name="reason" rows="2" class="form-control"></textarea></div>
            </div>

            <div class="form-group">
              <div class="col-sm-offset-2 col-sm-10">
                <div class="checkbox">
                  <label><input type="checkbox" name="notify_confirmed" value="1" /> {{ entry_notify_confirmed }}</label>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% if not permission_denied %}
<div id="rule-row-template" style="display:none;">
  <div class="row rule-row" style="margin-bottom:10px;">
    <div class="col-sm-2"><input type="number" name="rule_payment_number_from[]" class="form-control" placeholder="{{ entry_payment_from }}" /></div>
    <div class="col-sm-2"><input type="number" name="rule_payment_number_to[]" class="form-control" placeholder="{{ entry_payment_to }}" /></div>
    <div class="col-sm-2"><input type="number" name="rule_interval_value[]" value="1" class="form-control" placeholder="{{ entry_interval_value }}" /></div>
    <div class="col-sm-2">
      <select name="rule_interval_unit[]" class="form-control">
        <option value="DAY">DAY</option><option value="WEEK">WEEK</option><option value="MONTH" selected="selected">MONTH</option>
      </select>
    </div>
    <div class="col-sm-2"><input type="number" name="rule_coin_amount[]" value="0" class="form-control" placeholder="{{ text_amount }}" /></div>
    <div class="col-sm-1">
      <select name="rule_currency[]" class="form-control">
        {% for currency in currencies %}<option value="{{ currency }}">{{ currency }}</option>{% endfor %}
      </select>
    </div>
    <div class="col-sm-1"><button type="button" class="btn btn-danger remove-rule"><i class="fa fa-minus"></i></button></div>
  </div>
</div>
<script>
  (function () {
    var container = document.getElementById('rules-container');
    var rowTemplate = document.getElementById('rule-row-template').innerHTML;

    document.getElementById('add-rule').addEventListener('click', function () {
      var wrapper = document.createElement('div');
      wrapper.innerHTML = rowTemplate;
      container.appendChild(wrapper.firstElementChild);
    });

    container.addEventListener('click', function (e) {
      if (e.target.closest('.remove-rule')) {
        e.target.closest('.rule-row').remove();
      }
    });
  })();
</script>
{% endif %}
{{ footer }}

{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-alliance-account" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary">
          <i class="fa fa-save"></i>
        </button>
        <a href="{{ back }}" data-toggle="tooltip" title="{{ button_back }}" class="btn btn-default">
          <i class="fa fa-reply"></i>
        </a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li>
            <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid" id="alliance-page">
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible" role="alert">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
        <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      </div>
    {% endif %}
    {% if success %}
      <div class="alert alert-success alert-dismissible" role="alert">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
        <i class="fa fa-check-circle"></i> {{ success }}
      </div>
    {% endif %}

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_alliance_settings }}</h3>
      </div>
      <div class="panel-body">
        <form id="form-alliance-account" class="form-horizontal" action="{{ url_action }}" method="post" enctype="multipart/form-data">
          <input type="hidden" name="action" value="save" />
          <div class="form-group">
            <div class="col-sm-10">
              <h4>{{ text_help_settings }}</h4>
            </div>
          </div>
          <div class="form-group">
            <div class="col-sm-10">
              <h5>{{ text_help_jwt }}</h5>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="payment_alliance_url">{{ entry_api_url }}</label>
            <div class="col-sm-10">
              <div class="input-group">
                <span class="input-group-addon"><i class="fa fa-link fa-fw"></i></span>
                <input type="text" name="payment_alliance_url" id="payment_alliance_url" value="{{ payment_alliance_url }}" placeholder="" class="form-control" />
              </div>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="payment_alliance_jws_private_key">{{ entry_jws_private_key }}</label>
            <div class="col-sm-10">
              <textarea name="payment_alliance_jws_private_key" id="payment_alliance_jws_private_key" rows="6" placeholder="-----BEGIN PRIVATE KEY-----" class="form-control">{{ payment_alliance_jws_private_key }}</textarea>
              <p class="help-block">{{ help_jws_private_key }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="payment_alliance_jws_key_id">{{ entry_jws_key_id }}</label>
            <div class="col-sm-10">
              <div class="input-group">
                <span class="input-group-addon"><i class="fa fa-key fa-fw"></i></span>
                <input type="text" name="payment_alliance_jws_key_id" id="payment_alliance_jws_key_id" value="{{ payment_alliance_jws_key_id }}" placeholder="" class="form-control" />
              </div>
              <p class="help-block">{{ help_jws_key_id }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="payment_alliance_merchant_id">{{ merchant_id_key }}</label>
            <div class="col-sm-10">
              <div class="input-group">
                <span class="input-group-addon"><i class="fa fa-user fa-fw"></i></span>
                <input type="text" name="payment_alliance_merchant_id" id="payment_alliance_merchant_id" value="{{ payment_alliance_merchant_id }}" placeholder="" class="form-control" />
              </div>
              <p class="help-block">{{ help_merchant_id }}</p>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-hpp-type">{{ entry_hpp_type }}</label>
            <div class="col-sm-10">
              <select name="payment_alliance_hpp_type" id="input-hpp-type" class="form-control">
                <option value="" {{ payment_alliance_hpp_type is empty ? 'selected="selected"' : '' }}></option>
                <option value="PURCHASE" {{ payment_alliance_hpp_type == 'PURCHASE' ? 'selected="selected"' : '' }}>PURCHASE</option>
                <option value="A2A" {{ payment_alliance_hpp_type == 'A2A' ? 'selected="selected"' : '' }}>A2A</option>
                <option value="PREAUTH" {{ payment_alliance_hpp_type == 'PREAUTH' ? 'selected="selected"' : '' }}>PREAUTH</option>
              </select>
              <div id="a2a-currency-warning" class="alert alert-danger" style="display:none; margin-top:8px; margin-bottom:0;">
                <i class="fa fa-exclamation-triangle"></i> {{ error_a2a_uah_only|format(config_currency) }}
              </div>
              <p class="help-block">{{ help_hpp_type }}</p>
            </div>
          </div>

          <div id="preauth-exp-date-group" class="form-group" style="{{ payment_alliance_hpp_type == 'PREAUTH' ? '' : 'display:none;' }}">
            <label class="col-sm-2 control-label" for="payment_alliance_preauth_exp_date">{{ entry_preauth_exp_date }}</label>
            <div class="col-sm-10">
              <select name="payment_alliance_preauth_exp_date" id="payment_alliance_preauth_exp_date" class="form-control">
                <option value="2h" {{ payment_alliance_preauth_exp_date == '2h' ? 'selected="selected"' : '' }}>2 Hours</option>
                <option value="4h" {{ payment_alliance_preauth_exp_date == '4h' ? 'selected="selected"' : '' }}>4 Hours</option>
                <option value="6h" {{ payment_alliance_preauth_exp_date == '6h' ? 'selected="selected"' : '' }}>6 Hours</option>
                <option value="12h" {{ payment_alliance_preauth_exp_date == '12h' ? 'selected="selected"' : '' }}>12 Hours</option>
                <option value="1d" {{ payment_alliance_preauth_exp_date == '1d' ? 'selected="selected"' : '' }}>1 Day</option>
                <option value="2d" {{ payment_alliance_preauth_exp_date == '2d' ? 'selected="selected"' : '' }}>2 Days</option>
                <option value="7d" {{ payment_alliance_preauth_exp_date == '7d' ? 'selected="selected"' : '' }}>7 Days</option>
                <option value="14d" {{ payment_alliance_preauth_exp_date == '14d' ? 'selected="selected"' : '' }}>14 Days</option>
                <option value="28d" {{ payment_alliance_preauth_exp_date == '28d' ? 'selected="selected"' : '' }}>28 Days</option>
              </select>
              <p class="help-block">{{ help_preauth_exp_date }}</p>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_hpp_payment_methods }}</label>
            <div class="col-sm-10">
              {% for method in ['CARD', 'APPLE_PAY', 'GOOGLE_PAY'] %}
                <div class="checkbox">
                  <label>
                    <input type="checkbox" name="payment_alliance_hpp_payment_methods[]" value="{{ method }}"
                      {{ method in payment_alliance_hpp_payment_methods ? 'checked="checked"' : '' }} /> {{ method }}
                  </label>
                </div>
              {% endfor %}
              <p class="help-block">{{ help_hpp_payment_methods }}</p>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="payment_alliance_fail_url">{{ entry_fail_url }}</label>
            <div class="col-sm-10">
              <div class="input-group">
                <span class="input-group-addon"><i class="fa fa-link fa-fw"></i></span>
                <input type="text" name="payment_alliance_fail_url" id="payment_alliance_fail_url" value="{{ payment_alliance_fail_url }}" placeholder="" class="form-control" />
              </div>
              <p class="help-block">{{ help_fail_url }}</p>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="payment_alliance_success_url">{{ entry_success_url }}</label>
            <div class="col-sm-10">
              <div class="input-group">
                <span class="input-group-addon"><i class="fa fa-link fa-fw"></i></span>
                <input type="text" name="payment_alliance_success_url" id="payment_alliance_success_url" value="{{ payment_alliance_success_url }}" placeholder="" class="form-control" />
              </div>
              <p class="help-block">{{ help_success_url }}</p>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="payment_alliance_status" id="input-status" class="form-control">
                {% if payment_alliance_status %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
              <p class="help-block">{{ help_status }}</p>
            </div>
          </div>

          <hr />

          <div class="form-group">
            <div class="col-sm-10">
              <h3>{{ text_statuses }}</h3>
              <p class="help-block">{{ help_statuses }}</p>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_pending_status }}</label>
            <div class="col-sm-10">
              <select name="payment_alliance_pending_status" class="form-control">
                {% for order_status in order_statuses %}
                  {% if order_status.order_status_id == payment_alliance_pending_status %}
                    <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                  {% else %}
                    <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                  {% endif %}
                {% endfor %}
              </select>
              <p class="help-block">{{ help_pending_status }}</p>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_error_status }}</label>
            <div class="col-sm-10">
              <select name="payment_alliance_error_status" class="form-control">
                {% for order_status in order_statuses %}
                  {% if order_status.order_status_id == payment_alliance_error_status %}
                    <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                  {% else %}
                    <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                  {% endif %}
                {% endfor %}
              </select>
              <p class="help-block">{{ help_error_status }}</p>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_paid_status }}</label>
            <div class="col-sm-10">
              <select name="payment_alliance_paid_status" class="form-control">
                {% for order_status in order_statuses %}
                  {% if order_status.order_status_id == payment_alliance_paid_status %}
                    <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                  {% else %}
                    <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                  {% endif %}
                {% endfor %}
              </select>
              <p class="help-block">{{ help_paid_status }}</p>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_refunded_status }}</label>
            <div class="col-sm-10">
              <select name="payment_alliance_refunded_status" class="form-control">
                {% for order_status in order_statuses %}
                  {% if order_status.order_status_id == payment_alliance_refunded_status %}
                    <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                  {% else %}
                    <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                  {% endif %}
                {% endfor %}
              </select>
              <p class="help-block">{{ help_refunded_status }}</p>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_refund_fail_status }}</label>
            <div class="col-sm-10">
              <select name="payment_alliance_refund_fail_status" class="form-control">
                {% for order_status in order_statuses %}
                  {% if order_status.order_status_id == payment_alliance_refund_fail_status %}
                    <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                  {% else %}
                    <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                  {% endif %}
                {% endfor %}
              </select>
              <p class="help-block">{{ help_refund_fail_status }}</p>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_preauth_status }}</label>
            <div class="col-sm-10">
              <select name="payment_alliance_preauth_status" class="form-control">
                {% for order_status in order_statuses %}
                  {% if order_status.order_status_id == payment_alliance_preauth_status %}
                    <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                  {% else %}
                    <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                  {% endif %}
                {% endfor %}
              </select>
              <p class="help-block">{{ help_preauth_status }}</p>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_completion_status }}</label>
            <div class="col-sm-10">
              <select name="payment_alliance_completion_status" class="form-control">
                {% for order_status in order_statuses %}
                  {% if order_status.order_status_id == payment_alliance_completion_status %}
                    <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                  {% else %}
                    <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                  {% endif %}
                {% endfor %}
              </select>
              <p class="help-block">{{ help_completion_status }}</p>
            </div>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>
<style>
  .admin-statuses {
    padding-bottom: 20px;
  }
</style>
<script>
  (function () {
    var hppSelect    = document.getElementById('input-hpp-type');
    var preauthGroup = document.getElementById('preauth-exp-date-group');
    var a2aWarning   = document.getElementById('a2a-currency-warning');
    var saveBtn      = document.querySelector('button[form="form-alliance-account"]');
    var siteCurrency = '{{ config_currency }}';

    function togglePreauth() {
      preauthGroup.style.display = (hppSelect.value === 'PREAUTH') ? '' : 'none';
    }

    function toggleA2aWarning() {
      var isA2aNonUah = (hppSelect.value === 'A2A' && siteCurrency !== 'UAH');
      if (a2aWarning) { a2aWarning.style.display = isA2aNonUah ? '' : 'none'; }
      if (saveBtn)    { saveBtn.disabled = isA2aNonUah; }
    }

    hppSelect.addEventListener('change', function () {
      togglePreauth();
      toggleA2aWarning();
    });

    togglePreauth();
    toggleA2aWarning();
  })();
</script>
{{ footer }}
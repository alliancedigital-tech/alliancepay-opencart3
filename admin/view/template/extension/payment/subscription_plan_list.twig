{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ add }}" class="btn btn-primary"><i class="fa fa-plus"></i> {{ button_add }}</a>
        <a href="{{ back }}" data-toggle="tooltip" title="{{ button_back }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if warning %}
      <div class="alert alert-danger alert-dismissible" role="alert">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <i class="fa fa-exclamation-circle"></i> {{ warning }}
      </div>
    {% endif %}
    {% if success %}
      <div class="alert alert-success alert-dismissible" role="alert">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <i class="fa fa-check-circle"></i> {{ success }}
      </div>
    {% endif %}

    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-filter"></i> {{ text_filter }}</h3></div>
      <div class="panel-body">
        <form method="get" class="form-inline">
          <input type="hidden" name="route" value="extension/payment/subscription_plan" />
          <input type="hidden" name="user_token" value="{{ user_token }}" />
          <input type="number" name="filter_product_id" value="{{ filter_product_id }}" placeholder="{{ text_product_id }}" class="form-control" />
          <select name="filter_status" class="form-control">
            <option value="">{{ text_all_statuses }}</option>
            {% for status in ['ACTIVE', 'PAUSED', 'CANCELED', 'ERROR', 'ARCHIVED'] %}
              <option value="{{ status }}" {{ filter_status == status ? 'selected="selected"' : '' }}>{{ status }}</option>
            {% endfor %}
          </select>
          <select name="filter_sync_status" class="form-control">
            <option value="">{{ text_all_sync_statuses }}</option>
            {% for status in ['SYNCED', 'ERROR'] %}
              <option value="{{ status }}" {{ filter_sync_status == status ? 'selected="selected"' : '' }}>{{ status }}</option>
            {% endfor %}
          </select>
          <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> {{ button_filter }}</button>
        </form>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-body table-responsive">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <td>{{ column_product }}</td>
              <td>{{ column_provider_plan_id }}</td>
              <td>{{ column_status }}</td>
              <td>{{ column_sync_status }}</td>
              <td>{{ column_new_customers }}</td>
              <td>{{ column_active_subscriptions }}</td>
              <td class="text-right">{{ column_action }}</td>
            </tr>
          </thead>
          <tbody>
            {% for plan in plans %}
              <tr>
                <td>{{ plan.product_name }}</td>
                <td>{{ plan.provider_plan_id }}</td>
                <td>
                  <span class="label {{ plan.status == 'ACTIVE' ? 'label-success' : (plan.status == 'ERROR' ? 'label-danger' : 'label-default') }}">{{ plan.status }}</span>
                  {% if plan.is_archive_candidate %}<span class="label label-warning">{{ text_archive_candidate }}</span>{% endif %}
                </td>
                <td><span class="label {{ plan.sync_status == 'SYNCED' ? 'label-success' : 'label-danger' }}">{{ plan.sync_status }}</span></td>
                <td>{{ plan.is_active ? text_yes : text_no }}</td>
                <td>{{ plan.active_subscriptions_count }}</td>
                <td class="text-right">
                  <a href="{{ plan.edit }}" class="btn btn-primary btn-sm" data-toggle="tooltip" title="{{ button_edit }}"><i class="fa fa-pencil"></i></a>
                </td>
              </tr>
            {% else %}
              <tr><td class="text-center" colspan="7">{{ text_no_results }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
        {{ pagination }}
      </div>
    </div>
  </div>
</div>
{{ footer }}
